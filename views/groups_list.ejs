<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Groups | ModernChat</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/ui-enhancements.css">
</head>
<body class="bg-[#020617] text-slate-200 min-h-screen">
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary-900/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-900/10 rounded-full blur-3xl animate-pulse animation-delay-2000"></div>
  </div>

  <header class="bg-[#020617]/80 backdrop-blur-xl border-b border-white/5 px-6 py-6 sticky top-0 z-20">
    <div class="max-w-4xl mx-auto flex justify-between items-center">
      <h1 class="text-3xl font-extrabold tracking-tight text-white">Your Groups</h1>
      <a href="/dashboard" class="px-5 py-2.5 border border-white/10 text-sm font-semibold rounded-xl text-slate-300 bg-white/5 hover:bg-white/10 hover:text-white transition-all">Back to Dashboard</a>
    </div>
  </header>

  <main class="max-w-4xl mx-auto mt-10 px-4">
    <% if (groups.length > 0) { %>
      <div class="space-y-4">
        <% groups.forEach(group => { %>
          <div class="glass p-6 rounded-3xl border border-white/5 flex items-center justify-between group hover:bg-white/5 transition-all">
            <div class="flex items-center space-x-5">
              <img src="<%= group.icon || '/group_icons/default.png' %>" 
                   alt="<%= group.name %>"
                   class="w-16 h-16 rounded-2xl object-cover border border-white/10 shadow-2xl group-hover:scale-105 transition-transform">
              <div>
                <h2 class="text-xl font-bold text-white"><%= group.name %></h2>
                <p class="text-sm font-bold text-slate-500 uppercase tracking-widest mt-1"><%= group.members.length %> MEMBERS</p>
              </div>
            </div>
            <a href="/groups/<%= group._id %>" 
               class="btn-primary px-8 py-3 rounded-2xl font-bold">Open Chat</a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-20 glass rounded-3xl border border-dashed border-white/10">
        <svg class="mx-auto h-16 w-16 text-slate-600 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                d="M7 8h10M7 12h4m1 8h5a2 2 0 002-2v-5a2 2 0 00-2-2h-5a2 2 0 00-2 2v5a2 2 0 002 2zm3-10V6a2 2 0 012-2h2a2 2 0 012 2v2"></path>
        </svg>
        <h3 class="text-xl font-bold text-slate-300">No Groups Found</h3>
        <p class="text-slate-500 mt-2">You are not part of any groups yet.</p>
        <a href="/groups/create" 
           class="mt-8 btn-primary inline-flex items-center px-8 py-4 rounded-2xl font-bold">Create Group</a>
      </div>
    <% } %>
  </main>
</body>
</html>
