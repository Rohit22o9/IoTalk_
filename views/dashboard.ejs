<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | ModernChat</title>
    <script src="/js/theme-init.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/ui-enhancements.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f5f3ff',
                            100: '#ede9fe',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                            800: '#5b21b6',
                            900: '#4c1d95',
                        },
                        secondary: {
                            50: '#f8fafc',
                            100: '#f1f5f9',
                            500: '#64748b',
                            600: '#475569',
                            700: '#334155',
                            800: '#1e293b',
                            900: '#0f172a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --bg-color: #020617;
            --text-color: #e2e8f0;
            --header-bg: rgba(2, 6, 17, 0.8);
            --glass-bg: rgba(255, 255, 255, 0.08);
            --card-bg: rgba(255, 255, 255, 0.1);
            --border-color: rgba(255, 255, 255, 0.15);
            --sidebar-bg: #020617;
            --inner-card-bg: rgba(255, 255, 255, 0.12);
            --inner-border: rgba(255, 255, 255, 0.2);
        }

        body.light-theme {
            --bg-color: #f8fafc;
            --text-color: #1e293b;
            --header-bg: rgba(248, 250, 252, 0.8);
            --glass-bg: rgba(0, 0, 0, 0.02);
            --card-bg: #ffffff;
            --border-color: rgba(0, 0, 0, 0.08);
            --sidebar-bg: #ffffff;
            --inner-card-bg: #f1f5f9;
            --inner-border: rgba(0, 0, 0, 0.05);
        }

        body {
            background-color: var(--bg-color) !important;
            color: var(--text-color) !important;
            transition: background-color 0.3s ease, color 0.3s ease;
            position: relative;
            overflow-x: hidden;
        }

        .dashboard-wrapper {
            background-color: var(--bg-color) !important;
            position: relative;
            isolation: isolate;
        }

        .dashboard-wrapper::before {
            content: "";
            position: absolute;
            inset: 0;
            background: 
                radial-gradient(circle at 0% 0%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 100% 100%, rgba(59, 130, 246, 0.15) 0%, transparent 50%);
            z-index: -2;
            pointer-events: none;
        }

        .dashboard-wrapper::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
            opacity: 0.05;
            z-index: -1;
            pointer-events: none;
            mix-blend-mode: overlay;
        }

        .bg-glow-1 {
            position: fixed;
            top: -10%;
            right: -10%;
            width: 50vw;
            height: 50vw;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.1) 0%, transparent 70%);
            filter: blur(100px);
            z-index: -3;
            pointer-events: none;
        }

        .bg-glow-2 {
            position: fixed;
            bottom: -10%;
            left: -10%;
            width: 50vw;
            height: 50vw;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
            filter: blur(100px);
            z-index: -3;
            pointer-events: none;
        }

        .glass {
            background-color: var(--glass-bg) !important;
            border-color: var(--border-color) !important;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.2) !important;
        }

        .inner-card {
            background-color: var(--inner-card-bg) !important;
            border-color: var(--inner-border) !important;
        }

        .security-highlight {
            border-color: rgba(16, 185, 129, 0.5) !important;
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.2) !important;
            background: linear-gradient(to bottom right, rgba(16, 185, 129, 0.05), transparent) !important;
        }

        .light-theme .glass, .light-theme .bg-white\/5, .light-theme .bg-white\/\[0\.02\] {
            background-color: var(--card-bg) !important;
            border-color: var(--border-color) !important;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
        }

        .light-theme .inner-card, .light-theme .bg-white\/5:not(.glass) {
            background-color: var(--inner-card-bg) !important;
            border-color: var(--inner-border) !important;
        }

        .light-theme header {
            background-color: var(--header-bg) !important;
            border-color: var(--border-color) !important;
        }

        .light-theme h1, .light-theme h2, .light-theme h3, .light-theme .text-white {
            color: #0f172a !important;
        }

        .light-theme .text-slate-200, .light-theme .text-slate-300, .light-theme .text-slate-400 {
            color: #475569 !important;
        }

        .light-theme #theme-menu {
            background-color: #ffffff !important;
            border-color: #e2e8f0 !important;
        }

        .light-theme #theme-menu button {
            color: #475569 !important;
        }

        .light-theme #theme-menu button:hover {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
        }
        
        .light-theme .divide-white\/5 > * + * {
            border-color: #e2e8f0 !important;
        }
    </style>
    <script>
        function setTheme(theme) {
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
                document.body.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
                document.body.classList.remove('light-theme');
            }
            localStorage.setItem('theme', theme);
        }

        const translations = {
            en: {
                theme: "Theme",
                dark: "Dark",
                light: "Light",
                logged_in_as: "Logged in as",
                syncpilot: "SyncPilot",
                logout: "Logout",
                security_status: "Security Status",
                quantum_safe_active: "Quantum-Safe Active",
                quantum_safe_desc: "This app uses hybrid encryption aligned with post-quantum security standards.",
                security_dashboard: "Security Dashboard",
                encryption: "Encryption",
                enabled: "Enabled",
                quantum_safe: "Quantum-Safe",
                active: "Active",
                ai_moderation: "AI Moderation",
                running: "Running",
                secure_calls: "Secure Calls",
                quick_actions: "Quick Actions",
                new_community: "New Community",
                new_group: "New Group",
                your_communities: "Your Communities",
                places_you_belong: "Places you belong to"
            },
            hi: {
                theme: "थीम",
                dark: "डार्क",
                light: "लाइट",
                logged_in_as: "लॉग इन किया है",
                syncpilot: "सिंकपायलट",
                logout: "लॉगआउट",
                security_status: "सुरक्षा स्थिति",
                quantum_safe_active: "क्वांटम-सुरक्षित सक्रिय",
                quantum_safe_desc: "यह ऐप पोस्ट-क्वांटम सुरक्षा मानकों के अनुरूप हाइब्रिड एन्क्रिप्शन का उपयोग करता है।",
                security_dashboard: "सुरक्षा डैशबोर्ड",
                encryption: "एन्क्रिप्शन",
                enabled: "सक्षम",
                quantum_safe: "क्वांटम-सुरक्षित",
                active: "सक्रिय",
                ai_moderation: "AI मॉडरेशन",
                running: "चल रहा है",
                secure_calls: "सुरक्षित कॉल",
                quick_actions: "त्वरित कार्य",
                new_community: "नई कम्युनिटी",
                new_group: "नया ग्रुप",
                your_communities: "आपकी कम्युनिटी",
                places_you_belong: "वे स्थान जिनसे आप जुड़े हैं"
            },
            mr: {
                theme: "थीम",
                dark: "गडद",
                light: "प्रकाश",
                logged_in_as: "लॉग इन केले आहे",
                syncpilot: "सिंकपायलट",
                logout: "लॉगआउट",
                security_status: "सुरक्षा स्थिती",
                quantum_safe_active: "क्वांटम-सुरक्षित सक्रिय",
                quantum_safe_desc: "हे अ‍ॅप पोस्ट-क्वांटम सुरक्षा मानकांशी सुसंगत हायब्रिड एन्क्रिप्शन वापरते.",
                security_dashboard: "सुरक्षा डॅशबोर्ड",
                encryption: "एन्क्रिप्शन",
                enabled: "सक्षम",
                quantum_safe: "क्वांटम-सुरक्षित",
                active: "सक्रिय",
                ai_moderation: "AI मॉडरेशन",
                running: "चालू आहे",
                secure_calls: "सुरक्षित कॉल",
                quick_actions: "त्वरित कृती",
                new_community: "नवीन समुदाय",
                new_group: "नवीन गट",
                your_communities: "तुमचे समुदाय",
                places_you_belong: "तुम्ही ज्या ठिकाणांशी संबंधित आहात"
            }
        };

        function updateContent(lang) {
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.textContent = translations[lang][key];
                }
            });
            document.getElementById('current-lang').textContent = lang.toUpperCase();
        }

        function handleLanguageChange(lang) {
            localStorage.setItem('language', lang);
            updateContent(lang);
            document.getElementById('language-dropdown').classList.add('hidden');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('language') || 'en';
            updateContent(savedLang);

            const themeBtn = document.getElementById('theme-menu-button');
            const themeDropdown = document.getElementById('theme-dropdown');
            const langBtn = document.getElementById('language-menu-button');
            const langDropdown = document.getElementById('language-dropdown');

            if (themeBtn && themeDropdown) {
                themeBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    themeDropdown.classList.toggle('hidden');
                    if (langDropdown) langDropdown.classList.add('hidden');
                });
            }

            if (langBtn && langDropdown) {
                langBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    langDropdown.classList.toggle('hidden');
                    if (themeDropdown) themeDropdown.classList.add('hidden');
                });
            }

            document.addEventListener('click', (e) => {
                if (themeDropdown && !themeDropdown.contains(e.target) && e.target !== themeBtn) {
                    themeDropdown.classList.add('hidden');
                }
                if (langDropdown && !langDropdown.contains(e.target) && e.target !== langBtn) {
                    langDropdown.classList.add('hidden');
                }
            });
        });
    </script>
</head>
<body class="min-h-screen bg-[#020617] text-slate-200">
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-0 right-0 w-96 h-96 bg-primary-900/10 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-900/10 rounded-full blur-3xl animate-pulse animation-delay-2000"></div>
    </div>

    <div class="relative min-h-screen dashboard-wrapper">
        <!-- Header -->
        <header class="bg-[#020617]/80 backdrop-blur-xl border-b border-white/5 sticky top-0 z-20">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-20">
                    <div class="flex items-center">
                        <div class="h-12 w-12 bg-gradient-to-tr from-primary-600 to-blue-600 rounded-xl flex items-center justify-center shadow-[0_0_20px_rgba(139,92,246,0.2)]">
                            <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                            </svg>
                        </div>
                        <h1 class="ml-4 text-2xl font-bold tracking-tight text-white">ModernChat</h1>
                    </div>
                    <div class="flex items-center space-x-6">
                        <!-- Theme Switcher -->
                        <div class="relative inline-block text-left" id="theme-switcher-container">
                            <button type="button" class="inline-flex items-center px-4 py-2 border border-white/10 text-sm font-semibold rounded-xl text-slate-300 bg-white/5 hover:bg-white/10 hover:text-white transition-all" id="theme-menu-button">
                                <span data-i18n="theme">Theme</span>
                                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>
                            <div class="absolute right-0 mt-2 w-32 rounded-xl shadow-lg bg-[#0d1326] border border-white/10 hidden z-[60] overflow-hidden" id="theme-dropdown">
                                <div class="py-1">
                                    <button onclick="handleThemeChange('dark')" class="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white" data-i18n="dark">Dark</button>
                                    <button onclick="handleThemeChange('light')" class="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white" data-i18n="light">Light</button>
                                </div>
                            </div>
                        </div>

                        <!-- Language Switcher -->
                        <div class="relative inline-block text-left" id="language-switcher-container">
                            <button type="button" class="inline-flex items-center px-4 py-2 border border-white/10 text-sm font-semibold rounded-xl text-slate-300 bg-white/5 hover:bg-white/10 hover:text-white transition-all" id="language-menu-button">
                                <span id="current-lang">EN</span>
                                <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>
                            <div class="absolute right-0 mt-2 w-32 rounded-xl shadow-lg bg-[#0d1326] border border-white/10 hidden z-[60] overflow-hidden" id="language-dropdown">
                                <div class="py-1">
                                    <button onclick="handleLanguageChange('en')" class="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white">English</button>
                                    <button onclick="handleLanguageChange('hi')" class="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white">Hindi</button>
                                    <button onclick="handleLanguageChange('mr')" class="w-full text-left px-4 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white">Marathi</button>
                                </div>
                            </div>
                        </div>

                        <div class="text-right block">
                            <p class="text-xs font-medium text-slate-500 uppercase tracking-wider" data-i18n="logged_in_as">Logged in as</p>
                            <p class="text-sm font-bold text-white"><%= currentUser.username %></p>
                        </div>
                        
                        <!-- SyncPilot Button -->
                        <button onclick="openSyncPilot()" class="inline-flex items-center px-5 py-2.5 border border-primary-500/30 text-sm font-semibold rounded-xl text-primary-400 bg-primary-500/10 hover:bg-primary-500/20 transition-all">
                            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                            </svg>
                            <span data-i18n="syncpilot">SyncPilot</span>
                        </button>

                        <form action="/logout" method="GET" class="inline">
                            <button type="submit" class="inline-flex items-center px-5 py-2.5 border border-white/10 text-sm font-semibold rounded-xl text-slate-300 bg-white/5 hover:bg-white/10 hover:text-white transition-all">
                                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                </svg>
                                <span data-i18n="logout">Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
                <!-- User Profile Sidebar -->
                <div class="lg:col-span-1 space-y-6">
                    <div class="glass rounded-3xl p-8 border border-white/5 shadow-2xl text-center">
                        <div class="relative inline-block group">
                            <div class="absolute -inset-1 bg-gradient-to-r from-primary-500 to-blue-500 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
                            <img src="/avatars/<%= currentUser.avatar || 'default-avatar.png' %>" class="relative w-28 h-28 rounded-full object-cover border-4 border-[#020617] shadow-2xl">
                            <div class="absolute bottom-1 right-1 w-7 h-7 bg-emerald-500 border-4 border-[#020617] rounded-full"></div>
                        </div>
                        <h2 class="mt-6 text-2xl font-bold text-white"><%= currentUser.username %></h2>
                        <div class="mt-6 space-y-4">
                            <div class="flex items-center justify-center p-3 rounded-2xl bg-white/5 border border-white/5 text-slate-400 group hover:text-white transition-colors">
                                <svg class="h-5 w-5 mr-3 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0H8m8 0v2a2 2 0 01-2 2H10a2 2 0 01-2-2V6m8 0h2a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2h2"></path>
                                </svg>
                                <span class="text-sm font-medium"><%= currentUser.profession || "Set profession" %></span>
                            </div>
                            <div class="flex items-center justify-center p-3 rounded-2xl bg-white/5 border border-white/5 text-slate-400 group hover:text-white transition-colors">
                                <svg class="h-5 w-5 mr-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <span class="text-sm font-medium"><%= currentUser.location || "Set location" %></span>
                            </div>
                        </div>
                    </div>

                    <div class="glass rounded-3xl p-6 border border-white/5 space-y-4 security-highlight">
                        <h3 class="text-sm font-bold text-slate-500 uppercase tracking-widest px-2" data-i18n="security_status">Security Status</h3>
                        <div class="px-2">
                            <div class="flex items-start space-x-3 p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
                                <svg class="h-5 w-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                </svg>
                                <div class="text-xs leading-relaxed">
                                    <p class="font-bold uppercase tracking-wider mb-1" data-i18n="quantum_safe_active">Quantum-Safe Active</p>
                                    <p class="opacity-80" data-i18n="quantum_safe_desc">This app uses hybrid encryption aligned with post-quantum security standards.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="glass rounded-3xl p-6 border border-white/5 space-y-4">
                        <h3 class="text-sm font-bold text-slate-500 uppercase tracking-widest px-2" data-i18n="security_dashboard">Security Dashboard</h3>
                        <div class="px-2 space-y-3">
                            <div class="flex items-center justify-between text-xs p-2.5 rounded-xl bg-white/5 border border-white/5">
                                <span class="text-slate-400 flex items-center">
                                    <span class="mr-2">🔐</span> <span data-i18n="encryption">Encryption</span>
                                </span>
                                <span class="text-emerald-400 font-bold" data-i18n="enabled">Enabled</span>
                            </div>
                            <div class="flex items-center justify-between text-xs p-2.5 rounded-xl bg-white/5 border border-white/5">
                                <span class="text-slate-400 flex items-center">
                                    <span class="mr-2">🛡️</span> <span data-i18n="quantum_safe">Quantum-Safe</span>
                                </span>
                                <span class="text-emerald-400 font-bold" data-i18n="active">Active</span>
                            </div>
                            <div class="flex items-center justify-between text-xs p-2.5 rounded-xl bg-white/5 border border-white/5">
                                <span class="text-slate-400 flex items-center">
