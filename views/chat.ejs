    async function generateAIResponse() {
      console.log('🤖 Generating AI response...');
      const btn = document.getElementById('ai-reply-btn');
      const originalContent = btn.innerHTML;

      try {
        btn.disabled = true;
        btn.innerHTML = '<div class="animate-spin rounded-full h-5 w-5 border-b-2 border-blue-600"></div>';

        // Get conversation history from the page
        const conversationHistory = [];
        const messages = document.querySelectorAll('.message-container');

        messages.forEach(container => {
          const messageContent = container.querySelector('.msg-text-content');
          const isOwn = container.closest('.flex').classList.contains('justify-end');

          if (messageContent && messageContent.textContent.trim()) {
            let text = messageContent.textContent.trim();
            
            // Clean up text - remove potential "Username: " prefix
            const colonIndex = text.indexOf(':');
            if (colonIndex !== -1 && colonIndex < 30) {
              text = text.substring(colonIndex + 1).trim();
            }
            
            conversationHistory.push({
              role: isOwn ? 'assistant' : 'user',
              content: text
            });
          }
        });

        if (conversationHistory.length === 0) {
          btn.disabled = false;
          btn.innerHTML = originalContent;
          showNotification('No messages to generate response from', 'warning');
          return;
        }

        const recentMessages = conversationHistory.slice(-10);

        // Generate AI response
        const response = await fetch(`/api/ai/generate-reply/${otherUserId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            conversationHistory: recentMessages
          })
        });

        const result = await response.json();
        btn.disabled = false;
        btn.innerHTML = originalContent;

        if (result.success && result.replies && result.replies.length > 0) {
          showSmartRepliesPanel(result.replies);
        } else {
          showNotification('No replies could be generated', 'info');
        }

      } catch (error) {
        console.error('❌ Error generating AI response:', error);
        btn.disabled = false;
        btn.innerHTML = originalContent;
        showNotification('Failed to generate AI response', 'error');
      }
    }

