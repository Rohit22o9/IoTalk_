    function editMessage(messageId) {
      const messageElement = document.querySelector(`[data-id="${messageId}"]`);
      if (!messageElement) return;

      const textContent = messageElement.querySelector('.msg-text-content');
      if (!textContent) return;

      const originalText = textContent.textContent.trim();
      const input = document.createElement('textarea');
      input.className = 'w-full p-2 border rounded-md text-gray-800 text-sm';
      input.value = originalText;
      
      const saveBtn = document.createElement('button');
      saveBtn.className = 'mt-2 px-3 py-1 bg-primary-500 text-white rounded-md text-xs';
      saveBtn.textContent = 'Save';
      
      const cancelBtn = document.createElement('button');
      cancelBtn.className = 'mt-2 ml-2 px-3 py-1 bg-gray-300 text-gray-700 rounded-md text-xs';
      cancelBtn.textContent = 'Cancel';

      const editContainer = document.createElement('div');
      editContainer.appendChild(input);
      editContainer.appendChild(saveBtn);
      editContainer.appendChild(cancelBtn);

      const originalHTML = textContent.innerHTML;
      textContent.innerHTML = '';
      textContent.appendChild(editContainer);

      cancelBtn.onclick = () => {
        textContent.innerHTML = originalHTML;
      };

      saveBtn.onclick = async () => {
        const newText = input.value.trim();
        if (!newText || newText === originalText) {
          textContent.innerHTML = originalHTML;
          return;
        }

        try {
          const response = await fetch(`/message/${messageId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newMessage: newText })
          });

          if (response.ok) {
            showNotification('Message edited successfully', 'success');
            // Socket will handle UI update
          } else {
            const data = await response.json();
            showNotification(data.error || 'Failed to edit message', 'error');
            textContent.innerHTML = originalHTML;
          }
        } catch (error) {
          console.error('Error editing message:', error);
          showNotification('Failed to edit message', 'error');
          textContent.innerHTML = originalHTML;
        }
      };
    }

