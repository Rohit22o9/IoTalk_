
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Communities | Chat App</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/ui-enhancements.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#f5f3ff', 100: '#ede9fe',
              500: '#8b5cf6', 600: '#7c3aed',
              700: '#6d28d9', 800: '#5b21b6', 900: '#4c1d95',
            },
            secondary: {
              50: '#f8fafc', 100: '#f1f5f9',
              500: '#64748b', 600: '#475569',
              700: '#334155', 800: '#1e293b', 900: '#0f172a',
            }
          }
        }
      }
    }
  </script>
</head>

<body class="h-screen bg-[#020617] text-slate-200">
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary-900/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-900/10 rounded-full blur-3xl animate-pulse animation-delay-2000"></div>
  </div>
  <div class="relative h-full flex flex-col">
    <!-- Header -->
    <header class="bg-[#020617]/80 backdrop-blur-xl border-b border-white/5 px-6 py-6 sticky top-0 z-20">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center space-x-5">
          <form action="/dashboard" method="GET" class="inline">
            <button type="submit" class="p-3 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-all">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>
          </form>
          <h1 class="text-3xl font-extrabold tracking-tight text-white">Communities</h1>
        </div>
        <a href="/communities/create" class="btn-primary px-6 py-3 rounded-2xl flex items-center space-x-2 font-bold shadow-[0_0_20px_rgba(139,92,246,0.2)]">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          <span>Create New</span>
        </a>
      </div>
    </header>

    <!-- Communities Grid -->
    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-7xl mx-auto">
        <% if (communities.length === 0) { %>
          <div class="text-center py-20 bg-white/5 rounded-3xl border border-dashed border-white/10">
            <div class="w-20 h-20 bg-white/5 rounded-2xl flex items-center justify-center mx-auto mb-6">
              <svg class="h-10 w-10 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.196-2.121M8 20H3v-2a3 3 0 015.196-2.121M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-300">No communities yet</h3>
            <p class="text-slate-500 mt-2 max-w-xs mx-auto">Discover a new community or create your own to start chatting.</p>
            <div class="mt-8">
              <a href="/communities/create" class="btn-primary inline-flex items-center px-8 py-4 rounded-2xl font-bold">
                Get Started
              </a>
            </div>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% communities.forEach(community => { %>
              <div class="glass rounded-3xl p-8 border border-white/5 shadow-2xl hover:bg-white/10 transition-all duration-300 cursor-pointer relative group overflow-hidden" 
                   onclick="window.location.href='/communities/<%= community._id %>'">
                <div class="absolute top-0 right-0 w-32 h-32 bg-primary-600/10 rounded-full blur-3xl -mr-12 -mt-12 group-hover:bg-primary-600/20 transition-colors"></div>
                <div class="relative flex items-center space-x-5 mb-6">
                  <div class="relative flex-shrink-0">
                    <img src="<%= community.icon || '/group_icons/default.png' %>" 
                         alt="<%= community.name %>" 
                         class="w-16 h-16 rounded-2xl object-cover border-2 border-white/10 shadow-2xl group-hover:scale-105 transition-transform duration-500">
                  </div>
                  <div class="flex-1 min-w-0">
                    <h3 class="text-xl font-bold text-white truncate"><%= community.name %></h3>
                    <p class="text-sm font-bold text-slate-500 uppercase tracking-widest mt-1"><%= community.members.length %> MEMBERS</p>
                  </div>
                </div>
                
                <div class="relative">
                  <% if (community.description) { %>
                    <p class="text-slate-400 mb-6 line-clamp-2 leading-relaxed"><%= community.description %></p>
                  <% } %>
                  
                  <div class="flex items-center justify-between pt-6 border-t border-white/5">
                    <div class="flex items-center space-x-2 text-primary-400">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.196-2.121M8 20H3v-2a3 3 0 015.196-2.121M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                      </svg>
                      <span class="text-sm font-bold"><%= community.groups.length %> GROUPS</span>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
